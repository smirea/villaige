		"oxfmt": "^0.44.0",
		"oxlint": "^1.59.0",
		"react": "^19.2.5",
		"react-dom": "^19.2.5",
		"tailwindcss": "^4.2.2",
		"typescript": "^6.0.2",
		"vite": "^8.0.8",
		"vite-tsconfig-paths": "^6.1.1",
		"zod": "^4.3.6",
		"zod-to-ts": "^2.0.0"
	}
